# ---------------------------------------------------------------------------
# job-gestor environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Production (Vercel): set these in the Vercel project settings -> Environment
# Variables. Local dev: copy to `.env` at the repo root.
# ---------------------------------------------------------------------------

# Neon Postgres pooled connection string (postgres.js driver).
# Example: postgresql://user:password@host-pooler.us-east-1.aws.neon.tech/db?sslmode=require
# When unset, the app falls back to the in-memory dev repository so the UI and
# tests can run without a database.
DATABASE_URL=

# Secret passphrase the owner types to unlock edit controls (httpOnly cookie).
# Use a long, random value. Must match exactly, compared in constant time.
OWNER_PASSPHRASE=

# Cloudflare R2 credentials. Create an API token at
# https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens (create a token with
# "Object Read & Write" permission for this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 bucket name (create it at R2 -> Create bucket).
R2_BUCKET=

# Public base URL for serving attachment images. After enabling "Public access"
# on the bucket, Cloudflare shows a URL like https://pub-xxxxxxxxxxxxxxx.r2.dev
# (or your custom domain). When empty, the app stores just the object key.
R2_PUBLIC_BASE_URL=

# Public origin of the deployed app, used where absolute URLs are required.
APP_URL=
